{
  "name": "chatluna-plugin-google-reverse-image-search",
  "description": "为 ChatLuna 提供 Google Reverse Image Search（Google Lens 以图搜图）工具，支持 Scrapingdog Google Lens API 与 Google Cloud Vision Detecting Web API",
  "version": "0.1.0",
  "homepage": "https://github.com/CookSleep/chatluna-google-reverse-image-search",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CookSleep/chatluna-google-reverse-image-search.git"
  },
  "bugs": {
    "url": "https://github.com/CookSleep/chatluna-google-reverse-image-search/issues"
  },
  "contributors": [
    "CookSleep"
  ],
  "type": "module",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "GPL-3.0-only",
  "keywords": [
    "chatluna-plugin",
    "google-lens",
    "reverse-image-search"
  ],
  "devDependencies": {
    "typescript": "7.0.2",
    "@chatluna/message": "workspace:*",
    "@chatluna/storage-files": "workspace:*",
    "@cordisjs/plugin-database": "*",
    "@cordisjs/plugin-http": "*"
  },
  "peerDependencies": {
    "@chatluna/schema": "*",
    "@chatluna/tool": "*",
    "@chatluna/transform": "*",
    "cordis": "*"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "cordis": {
    "category": "tool",
    "description": {
      "zh": "为 ChatLuna 提供 Google Reverse Image Search（Google Lens 以图搜图）工具，支持 Scrapingdog Google Lens API 与 Google Cloud Vision Detecting Web API。"
    },
    "service": {
      "required": [
        "tools",
        "http",
        "model",
        "database",
        "chatluna_storage"
      ]
    }
  }
}
